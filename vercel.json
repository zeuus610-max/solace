{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/css/(.*)", "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "/frontend/js/$1" },
    { "src": "/scanner", "dest": "/frontend/scanner.html" },
    { "src": "/dashboard", "dest": "/frontend/dashboard.html" },
    { "src": "/about", "dest": "/frontend/about.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
