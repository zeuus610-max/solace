FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --gid 10001 web \
    && useradd --uid 10001 --gid web --no-create-home --shell /usr/sbin/nologin web \
    && mkdir -p /site/assets \
    && chown -R web:web /site

WORKDIR /site
COPY --chown=web:web index.html ./index.html
COPY --chown=web:web assets/ ./assets/

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/', timeout=3)"]

CMD ["python", "-m", "http.server", "8000", "--bind", "0.0.0.0", "--directory", "/site"]
